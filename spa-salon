        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Hero Content -->
                <div class="lg:col-span-7 text-right">
                    
                    <!-- Status Indicator -->
                    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold mb-6">
                        <span class="relative flex h-2.5 w-2.5">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                        </span>
                        <span>أقرب موعد متاح: اليوم 04:30 مساءً</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-brand-navy leading-tight tracking-tight mb-6">
                        عناية وحلاقة <br>
                        <span class="text-brand-red">تعرف وش تبغى</span>
                    </h1>

                    <p class="text-lg sm:text-xl text-gray-600 font-medium leading-relaxed mb-8 max-w-2xl">
                        حلاقة شعر، بديكير، مساج، وعناية متكاملة بأسلوب حديث وأخصائيين محترفين. احجز وقتك من الجوال وتعال بدون انتظار.
                    </p>

                    <!-- Hero Actions -->
                    <div class="flex flex-wrap items-center gap-4">
                        <a href="#booking" onclick="scrollToBooking()" class="bg-brand-red hover:bg-brand-redHover text-white px-8 py-4 rounded-xl font-bold text-lg shadow-lg shadow-brand-red/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-3">
                            <span>احجز موعدك الآن</span>
                            <i class="fa-solid fa-arrow-left text-sm"></i>
                        </a>
                        <a href="#services" class="border-2 border-brand-navy text-brand-navy hover:bg-brand-navy hover:text-white px-7 py-3.5 rounded-xl font-bold text-lg transition-all">
                            عرض الأسعار
                        </a>
                    </div>

                    <!-- Micro Highlights -->
                    <div class="mt-12 grid grid-cols-3 gap-4 border-t border-gray-200 pt-6">
                        <div>
                            <p class="text-2xl font-extrabold text-brand-navy">100%</p>
                            <p class="text-xs font-semibold text-gray-500 mt-1">أدوات معقمة فردية</p>
                        </div>
                        <div>
                            <p class="text-2xl font-extrabold text-brand-navy">4.9 ★</p>
                            <p class="text-xs font-semibold text-gray-500 mt-1">تقييم +1500 عميل</p>
                        </div>
                        <div>
                            <p class="text-2xl font-extrabold text-brand-navy">0 دقيقة</p>
                            <p class="text-xs font-semibold text-gray-500 mt-1">التزام تام بالمواعيد</p>
                        </div>
                    </div>
                </div>

                <!-- Hero Card / Illustration Visual -->
                <div class="lg:col-span-5">
                    <div class="relative bg-white p-6 sm:p-8 rounded-3xl border-2 border-brand-navy/10 shadow-2xl shadow-gray-200/50">
                        <div class="absolute -top-4 -right-4 bg-brand-red text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-md">
                            تحديث حظي مباشر
                        </div>

                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-16 h-16 rounded-2xl bg-brand-grayBg border border-gray-200 flex items-center justify-center text-brand-navy text-2xl">
                                <i class="fa-solid fa-spa text-brand-red"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-brand-navy">باقة العناية الملكية</h3>
                                <p class="text-sm font-semibold text-gray-500">حلاقة + بديكير + مساج رأس</p>
                            </div>
                        </div>

                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between items-center text-sm p-3 rounded-xl bg-brand-grayBg">
                                <span class="font-bold text-brand-navy"><i class="fa-solid fa-scissors text-brand-red ml-2"></i>حلاقة شعر احترافية</span>
                                <span class="font-extrabold text-brand-navy">40 ر.س</span>
                            </div>
                            <div class="flex justify-between items-center text-sm p-3 rounded-xl bg-brand-grayBg">
                                <span class="font-bold text-brand-navy"><i class="fa-solid fa-hand-holding-droplet text-brand-red ml-2"></i>بديكير وسبا الأقدام</span>
                                <span class="font-extrabold text-brand-navy">120 ر.س</span>
                            </div>
                            <div class="flex justify-between items-center text-sm p-3 rounded-xl bg-brand-grayBg">
                                <span class="font-bold text-brand-navy"><i class="fa-solid fa-hot-tub-person text-brand-red ml-2"></i>مساج وحمام زيت</span>
                                <span class="font-extrabold text-brand-navy">مجاني مع الباقة</span>
                            </div>
                        </div>

                        <button onclick="selectServiceQuickly('combo')" class="w-full bg-brand-navy hover:bg-brand-navyLight text-white font-bold py-3.5 rounded-xl shadow transition-all flex items-center justify-center gap-2">
                            <span>اختيار هذه الباقة والتنقل للحجز</span>
                            <i class="fa-solid fa-bolt text-yellow-400"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SERVICES & PRICES SECTION -->
    <section id="services" class="py-16 bg-brand-grayBg border-y border-gray-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-brand-red font-bold text-sm tracking-wider uppercase bg-brand-red/10 px-3 py-1 rounded-full">قائمة الخدمات المتاحة</span>
                <h2 class="text-3xl sm:text-4xl font-black text-brand-navy mt-3">خدمات الحلاقة والعناية والبديكير</h2>
                <p class="text-gray-600 font-medium mt-2">أسعار واضحة وخدمة فائقة الجودة باستخدام أفضل المستحضرات العالمية</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                
                <!-- Service 1: Haircut -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-scissors"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">40 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">حلاقة وقص شعر</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">قص وتصفيف وتسريح كلاسيكي أو عصري متناسب مع شكل وجهك مع غسيل الشعر.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>30 دقيقة</span>
                        <button onclick="startBookingWithService('haircut')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 2: Pedicure -->
                <div class="bg-white p-6 rounded-2xl border-2 border-brand-red/20 shadow-md relative flex flex-col justify-between">
                    <div class="absolute -top-3 left-4 bg-brand-red text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">
                        الأكثر طلباً
                    </div>
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-spa"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">120 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">بديكير وسبا العناية باليدين والقدمين</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">جلسة استرخائية لتنظيف، تقشير، وترطيب الأظافر والجلد الميت مع مساج دافئ.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>45 دقيقة</span>
                        <button onclick="startBookingWithService('pedicure')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 3: Beard Grooming -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-user-ninja"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">30 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">حلاقة وتحديد لحية</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">تحديد دقيق بالمنشفة الساخنة والزيوت الطبيعية للحفاظ على رطوبة البشرة.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>30 دقيقة</span>
                        <button onclick="startBookingWithService('beard')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 4: Package -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-gem"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">150 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">باقة القص والبديكير الشاملة</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">تدمج حلاقة الشعر وتصفيفه مع جلسة بديكير متكاملة للقدمين واليدين وتوفير خاص.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>60 دقيقة</span>
                        <button onclick="startBookingWithService('combo')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 5: Facial -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-face-smile"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">200 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">جلسة تنظيف بشرة (هيدرافيشل)</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">تنظيف عميق للمسام، إزالة الرؤوس السوداء، وترطيب البشرة بماسكات طين وفيتامينات.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>45 دقيقة</span>
                        <button onclick="startBookingWithService('facial')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 6: Full VIP Massage -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-xl bg-red-50 text-brand-red flex items-center justify-center text-xl">
                                <i class="fa-solid fa-hot-tub-person"></i>
                            </div>
                            <span class="text-2xl font-black text-brand-navy">180 <span class="text-xs font-bold text-gray-500">ر.س</span></span>
                        </div>
                        <h3 class="text-xl font-bold text-brand-navy mb-2">مساج استرخائي للرقبة والظهر</h3>
                        <p class="text-gray-600 text-sm font-medium leading-relaxed mb-4">مساج بالزيوت العطرية الدافئة لتخفيف الإجهاد والتصلب بعد أسبوع عمل طويل.</p>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-xs font-bold text-gray-500">
                        <span><i class="fa-regular fa-clock ml-1"></i>40 دقيقة</span>
                        <button onclick="startBookingWithService('massage')" class="text-brand-red hover:underline font-bold text-sm flex items-center gap-1">
                            احجز الخدمة <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
