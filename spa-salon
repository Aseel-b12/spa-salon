    <!-- AI BARBER & SPA ADVISOR SECTION -->
    <section id="ai-advisor" class="py-16 bg-white border-b border-gray-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-brand-navy rounded-3xl text-white p-6 sm:p-10 shadow-xl relative overflow-hidden">
                <!-- Decorative Graphic -->
                <div class="absolute -left-10 -bottom-10 w-48 h-48 bg-brand-red/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8 border-b border-gray-700/80 pb-6">
                    <div>
                        <div class="inline-flex items-center gap-2 bg-brand-red px-3 py-1 rounded-full text-xs font-bold mb-3">
                            <i class="fa-solid fa-robot"></i>
                            <span>مستشار السبا والحلاقة الذكي AI</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold">محتار وش الحلاقة أو الخدمة اللي تناسبك؟</h2>
                        <p class="text-gray-300 text-sm mt-1">اختر شكل وجهك أو استفسارك وسيقوم الذكاء الاصطناعي باقتراح القَصّة والخدمة المثالية لك فوراً.</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-yellow-400 text-2xl flex-shrink-0">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                </div>

                <!-- Quick Prompt Buttons -->
