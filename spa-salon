    <script>
        // Booking State Object
        const bookingState = {
            step: 1,
            serviceId: 'haircut',
            serviceName: 'حلاقة وقص شعر',
            price: 40,
            specialist: 'أي أخصائي متاح',
            date: '',
            time: '04:30 مساءً',
            custName: '',
            custPhone: ''
        };

        // Initialize Dates Generator on Load
        window.onload = function() {
            renderDates();
            updateStepView();
        };

        // Date Cards Generation for Step 3
        function renderDates() {
            const dateContainer = document.getElementById('date-cards-container');
            dateContainer.innerHTML = '';

            const days = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
            const today = new Date();

            for(let i = 0; i < 4; i++) {
                const currentDate = new Date(today);
                currentDate.setDate(today.getDate() + i);

                const dayName = i === 0 ? 'اليوم' : (i === 1 ? 'غداً' : days[currentDate.getDay()]);
                const formattedDate = `${currentDate.getDate()} / ${currentDate.getMonth() + 1}`;

                if(i === 0) bookingState.date = `${dayName} (${formattedDate})`;

                const isSelected = i === 0 ? 'border-brand-red bg-red-50/50' : 'border-gray-200';

                const cardHtml = `
                    <div onclick="selectDate('${dayName} (${formattedDate})', this)" class="date-card border-2 ${isSelected} p-3 rounded-xl cursor-pointer hover:border-brand-red text-center transition-all">
                        <p class="text-xs font-bold text-gray-500">${dayName}</p>
                        <p class="text-base font-extrabold text-brand-navy mt-1">${formattedDate}</p>
                    </div>
                `;
                dateContainer.innerHTML += cardHtml;
            }
        }

        // Stepper Navigation Logic
        function updateStepView() {
            // Hide all steps
            for (let i = 1; i <= 5; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
                
                // Update tabs header
                const tab = document.getElementById(`step-tab-${i}`);
                if (i < bookingState.step) {
                    tab.className = "flex items-center gap-2 font-bold text-sm text-emerald-600 flex-shrink-0";
                    tab.querySelector('span:first-child').className = "w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs";
                } else if (i === bookingState.step) {
                    tab.className = "flex items-center gap-2 font-bold text-sm text-brand-red flex-shrink-0";
                    tab.querySelector('span:first-child').className = "w-8 h-8 rounded-full bg-brand-red text-white flex items-center justify-center text-xs";
                } else {
                    tab.className = "flex items-center gap-2 font-bold text-sm text-gray-400 flex-shrink-0";
                    tab.querySelector('span:first-child').className = "w-8 h-8 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center text-xs";
                }
            }

            // Show current step
            document.getElementById(`step-${bookingState.step}`).classList.remove('hidden');

            // Previous Button visibility
            const btnPrev = document.getElementById('btn-prev');
            if (bookingState.step > 1) {
                btnPrev.classList.remove('invisible');
            } else {
                btnPrev.classList.add('invisible');
            }

            // Next Button text
            const btnNext = document.getElementById('btn-next');
            if (bookingState.step === 5) {
                btnNext.innerHTML = `<span>تأكيد الحجز واستخراج التذكرة</span> <i class="fa-solid fa-check"></i>`;
                btnNext.className = "bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-6 py-3 rounded-xl shadow transition-all flex items-center gap-2";
            } else {
                btnNext.innerHTML = `<span>المتابعة</span> <i class="fa-solid fa-arrow-left"></i>`;
                btnNext.className = "bg-brand-red hover:bg-brand-redHover text-white font-bold text-sm px-6 py-3 rounded-xl shadow transition-all flex items-center gap-2";
            }
        }

        function nextStep() {
            if (bookingState.step === 5) {
                // Validation for step 5
                const name = document.getElementById('cust-name').value.trim();
                const phone = document.getElementById('cust-phone').value.trim();

                if (!name || !phone) {
                    alert("يرجى كتابة الاسم ورقم الجوال لتأكيد موعدك.");
                    return;
                }

                bookingState.custName = name;
                bookingState.custPhone = phone;
                showTicketModal();
                return;
            }

            bookingState.step++;
            updateStepView();
        }

        function prevStep() {
            if (bookingState.step > 1) {
                bookingState.step--;
                updateStepView();
            }
        }

        // Selection Helpers
        function selectService(id, name, price) {
            bookingState.serviceId = id;
            bookingState.serviceName = name;
            bookingState.price = price;

            // Highlight border
            document.querySelectorAll('.service-card').forEach(el => el.classList.remove('border-brand-red', 'bg-red-50/50'));
            event.currentTarget.classList.add('border-brand-red', 'bg-red-50/50');
        }

        function selectServiceQuickly(id) {
            const map = {
                'haircut': { name: 'حلاقة وقص شعر', price: 40 },
                'pedicure': { name: 'بديكير وسبا العناية باليدين والقدمين', price: 120 },
                'combo': { name: 'باقة القص والبديكير الشاملة', price: 150 }
            };
            if(map[id]) {
                selectService(id, map[id].name, map[id].price);
            }
            scrollToBooking();
        }

        function startBookingWithService(id) {
            selectServiceQuickly(id);
        }

        function selectSpecialist(name) {
            bookingState.specialist = name;
            document.querySelectorAll('.barber-card').forEach(el => el.classList.remove('border-brand-red', 'bg-red-50/50'));
            event.currentTarget.classList.add('border-brand-red', 'bg-red-50/50');
        }

        function selectDate(dateStr, element) {
            bookingState.date = dateStr;
            document.querySelectorAll('.date-card').forEach(el => el.classList.remove('border-brand-red', 'bg-red-50/50'));
            element.classList.add('border-brand-red', 'bg-red-50/50');
        }

        function selectTime(timeStr) {
            bookingState.time = timeStr;
            document.querySelectorAll('.time-btn').forEach(el => {
                el.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
                el.classList.add('text-brand-navy', 'border-gray-300');
            });
            event.currentTarget.classList.remove('border-gray-300');
            event.currentTarget.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy');
        }

        function scrollToBooking() {
            document.getElementById('booking').scrollIntoView({ behavior: 'smooth' });
        }

        // Ticket Modal Logic
        function showTicketModal() {
            const ticketCode = 'SPA-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('ticket-code').innerText = ticketCode;
            document.getElementById('ticket-name').innerText = bookingState.custName;
            document.getElementById('ticket-service').innerText = bookingState.serviceName;
            document.getElementById('ticket-specialist').innerText = bookingState.specialist;
            document.getElementById('ticket-datetime').innerText = `${bookingState.date} - ${bookingState.time}`;
            document.getElementById('ticket-price').innerText = `${bookingState.price} ر.س`;

            document.getElementById('ticket-modal').classList.remove('hidden');
            document.getElementById('ticket-modal').classList.add('flex');
        }

        function closeTicketModal() {
            document.getElementById('ticket-modal').classList.add('hidden');
            document.getElementById('ticket-modal').classList.remove('flex');
        }

        function sendToWhatsApp() {
            const text = `مرحباً سبا صالون، أود تأكيد حجز موعدي:%0A- الاسم: ${bookingState.custName}%0A- الخدمة: ${bookingState.serviceName}%0A- الأخصائي: ${bookingState.specialist}%0A- الموعد: ${bookingState.date} الساعة ${bookingState.time}%0A- السعر: ${bookingState.price} ر.س`;
            window.open(`https://wa.me/966500000000?text=${text}`, '_blank');
        }

        // AI Barber & Spa Advisor Chat Logic
        function askAI(promptText) {
            document.getElementById('ai-input').value = promptText;
            handleAISubmit(new Event('submit'));
        }

        function handleAISubmit(e) {
            e.preventDefault();
            const input = document.getElementById('ai-input');
            const userMsg = input.value.trim();
            if(!userMsg) return;

            const chatBox = document.getElementById('ai-chat-box');

            // Render User Bubble
            const userBubble = `
                <div class="flex items-start gap-3 justify-end">
                    <div class="bg-brand-red text-white p-3.5 rounded-2xl rounded-tl-none text-sm font-medium max-w-xl">
                        ${userMsg}
                    </div>
                </div>
            `;
            chatBox.innerHTML += userBubble;
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            // Generate AI Response
            setTimeout(() => {
                let aiReply = "للحصول على المظهر الأفضل، نوصي بحجز جلسة **حلاقة وقص شعر** مع أخصائينا لمعاينة طبيعة شعر وجهك وبشرتك مباشرة.";

                if (userMsg.includes('بيضاوي')) {
                    aiReply = "الوجه البيضاوي يناسبه معظم القصات! نوصي بـ **قص شعر متدرج مع تحديد اللحية** لإبراز تناسق وجهك. ننصحك بحجز (باقة القص والبديكير الشاملة).";
                } else if (userMsg.includes('دائري')) {
                    aiReply = "الوجه الدائري يناسبه تخفيف الجوانب وتطويل الشعر من الأعلى مع **تحديد اللحية بشكل حاد** لإعطاء الوجه طُولاً ورزانة.";
                } else if (userMsg.includes('بديكير')) {
                    aiReply = "بديكير السبا يساعد في أزالة الجلد الميت، نشاط الدورة الدموية، والوقاية من انغراس الأظافر. ننصحك بجلسة **بديكير وسبا العناية (120 ر.س)** لمزيد من الراحة.";
                } else if (userMsg.includes('عناية') || userMsg.includes('بعد الحلاقة')) {
                    aiReply = "بعد الحلاقة يفضل استخدام مرطب خالٍ من الكحول وغسل الوجه بماء بارد لإغلاق المسام. كما ننصح بجلسة **تنظيف البشرة الهيدرافيشل** مرة شهرياً.";
                }

                const aiBubble = `
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-brand-red flex items-center justify-center text-xs text-white font-bold flex-shrink-0">
                            AI
                        </div>
                        <div class="bg-white/10 p-3.5 rounded-2xl rounded-tr-none text-sm font-medium leading-relaxed max-w-xl border border-white/5">
                            ${aiReply}
                            <div class="mt-3">
                                <button onclick="scrollToBooking()" class="text-xs bg-brand-red hover:bg-brand-redHover text-white px-3 py-1.5 rounded-lg font-bold">
                                    انتقل للحجز بناءً على هذا الاقتراح <i class="fa-solid fa-arrow-left mr-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                chatBox.innerHTML += aiBubble;
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 600);
        }
    </script>
