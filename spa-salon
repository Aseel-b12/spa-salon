<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سبا صالون - عناية وحلاقة متكاملة</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Tajawal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#b3262e',
                            redHover: '#8e1e24',
                            navy: '#14202e',
                            navyLight: '#1f2e42',
                            grayBg: '#f8fafc',
                            grayBorder: '#e2e8f0'
                        }
                    },
                    fontFamily: {
                        sans: ['Tajawal', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #ffffff;
            color: #14202e;
        }

        /* Pattern overlay similar to requested Grid/Tile pattern */
        .bg-grid-pattern {
            background-color: #ffffff;
            background-image: linear-gradient(to right, rgba(200, 200, 200, 0.12) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(200, 200, 200, 0.12) 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* Custom Scrollbar for Chat and Steps */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .chat-bubble-ai {
            border-bottom-right-radius: 0;
        }
        .chat-bubble-user {
            border-bottom-left-radius: 0;
        }
    </style>
</head>
<body class="bg-grid-pattern antialiased min-h-screen flex flex-col justify-between selection:bg-brand-red selection:text-white">

    <!-- NAVIGATION HEADER -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 bg-brand-navy rounded-xl flex items-center justify-center text-brand-red shadow-md group-hover:scale-105 transition-transform">
                    <i class="fa-solid font-bold text-2xl fa-scissors"></i>
                </div>
                <div>
                    <span class="text-2xl font-black text-brand-navy tracking-tight block leading-none">سبا صالون</span>
                    <span class="text-xs font-semibold text-brand-red tracking-wider block mt-1">SPA & BARBER</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 font-semibold text-brand-navy">
                <a href="#services" class="hover:text-brand-red transition-colors">الخدمات والأسعار</a>
                <a href="#ai-advisor" class="hover:text-brand-red transition-colors flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-brand-red animate-ping"></span>
                    المستشار الذكي AI
                </a>
                <a href="#specialists" class="hover:text-brand-red transition-colors">الأخصائيين</a>
                <a href="#loyalty" class="hover:text-brand-red transition-colors">برنامج الولاء</a>
            </nav>

            <!-- CTA Button -->
            <div class="flex items-center gap-3">
                <a href="#booking" onclick="scrollToBooking()" class="bg-brand-red hover:bg-brand-redHover text-white px-5 py-2.5 rounded-xl font-bold shadow-md shadow-brand-red/20 transition-all active:scale-95 flex items-center gap-2">
                    <i class="fa-regular fa-calendar-check text-lg"></i>
                    <span>احجز موعد</span>
                </a>
            </div>
        </div>
    </header>

    <!-- MAIN HERO SECTION -->
